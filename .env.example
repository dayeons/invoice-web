# 노션 연동 (서버 전용 값 — NEXT_PUBLIC_ 접두사를 붙이지 마세요)
# 실제 값은 .env에만 넣고, 이 파일에는 자리표시자만 둡니다.
NOTION_API_KEY=your_notion_integration_secret
NOTION_DATABASE_ID=your_notion_database_id

# 사이트 URL (선택, 서버/브라우저 공개 값 — 견적서 공유 링크와 메타데이터의 기준 도메인)
# 우선순위: NEXT_PUBLIC_SITE_URL → Vercel 배포 URL(자동 설정) → http://localhost:3000
# 커스텀 도메인을 쓸 때만 설정하세요. 끝의 /는 있어도 제거됩니다. 빌드 시점에 고정되므로 변경 후 다시 빌드합니다.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
