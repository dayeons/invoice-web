# 노션 연동 (서버 전용 값 — NEXT_PUBLIC_ 접두사를 붙이지 마세요)
# 실제 값은 .env에만 넣고, 이 파일에는 자리표시자만 둡니다.
NOTION_API_KEY=your_notion_integration_secret
NOTION_DATABASE_ID=your_notion_database_id

# 사이트 URL (선택, 서버/브라우저 공개 값 — 견적서 공유 링크와 메타데이터의 기준 도메인)
# 우선순위: NEXT_PUBLIC_SITE_URL → Vercel 배포 URL(자동 설정) → http://localhost:3000
# 커스텀 도메인을 쓸 때만 설정하세요. 끝의 /는 있어도 제거됩니다. 빌드 시점에 고정되므로 변경 후 다시 빌드합니다.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 견적서 캐시 즉시 재검증 토큰 (선택, 서버 전용 — NEXT_PUBLIC_ 접두사 금지)
# POST /api/revalidate 호출 시 Authorization: Bearer <값> 으로 보냅니다. 비어 있으면 엔드포인트는 503으로 닫힙니다.
# 충분히 긴 무작위 문자열을 쓰세요. (예: openssl rand -base64 32)
REVALIDATE_SECRET=your_revalidate_secret

# 관리자 화면(/admin) 접근 보호 (선택, 서버 전용 — NEXT_PUBLIC_ 접두사 금지)
# 두 값이 모두 있어야 관리자 로그인이 열립니다. 하나라도 비어 있으면 관리자 기능은 닫힙니다.
# ADMIN_PASSWORD: 로그인 비밀번호. 시도 횟수 제한이 없으므로 충분히 긴 무작위 문자열을 쓰세요. (예: openssl rand -base64 32)
# ADMIN_SESSION_SECRET: 세션 쿠키 서명 비밀키. 비밀번호와 다른 무작위 값을 쓰세요. 바꾸면 모든 세션이 로그아웃됩니다.
ADMIN_PASSWORD=your_admin_password
ADMIN_SESSION_SECRET=your_admin_session_secret
